# Copy to .env and fill in. .env is gitignored — never commit your keys.

# Required for live transcription + diarization:
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Optional — turns on real intelligence (M1). Without it, the page runs the
# offline heuristic brain and the indicator shows "heuristic" instead of "AI Enhanced".
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional model overrides:
# ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001   # per-utterance classification (low latency)
# ANTHROPIC_MODEL_DEEP=claude-sonnet-4-6           # scorecard + coaching analysis
# PORT=8787

# Local/self-hosted ASR variant (npm run start:local) — no third party, audio
# stays on your machine. Point at a running WhisperLiveKit server:
# WLK_URL=ws://localhost:8000/asr
